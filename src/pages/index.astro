---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const dateFormat = new Intl.DateTimeFormat('ru-RU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Layout title={`${profile.name} — блог`} description="Статьи и заметки">
  <Header />

  <main>
    <section class="hero hero-compact">
      <div class="container">
        <p class="eyebrow">Блог</p>
        <h1>Статьи и заметки</h1>
        <p class="tagline">{profile.tagline}</p>
      </div>
    </section>

    <section class="section" style="padding-top: 24px;">
      <div class="container">
        <div class="post-list">
          {posts.map((post) => (
            <a class="post-card" href={`${import.meta.env.BASE_URL}${post.id}/`}>
              <time datetime={post.data.pubDate.toISOString()}>
                {dateFormat.format(post.data.pubDate)}
              </time>
              <span class="post-title">{post.data.title}</span>
              {post.data.description && (
                <span class="post-description">{post.data.description}</span>
              )}
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

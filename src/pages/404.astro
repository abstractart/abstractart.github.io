---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
---

<Layout title={`Страница не найдена — ${profile.name}`}>
  <Header />

  <main>
    <section class="hero">
      <div class="container">
        <p class="eyebrow">Ошибка 404</p>
        <h1>Страница не найдена</h1>
        <p class="tagline">По этому адресу ничего нет — возможно, ссылка устарела.</p>
        <div class="actions">
          <a class="button button-primary" href={`${import.meta.env.BASE_URL}`}>На главную</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
